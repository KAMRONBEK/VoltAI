{
  "name": "voltai-api",
  "version": "1.0.0",
  "description": "VoltAI backend for EV station aggregation",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "scrape:app": "tsx scrapers/run-app-scraper.ts",
    "scrape:http": "tsx scrapers/http/run.ts",
    "enrich:tokbor": "tsx scrapers/http/enrich-tokbor.ts",
    "auth:tokbor": "tsx scrapers/auth/cli.ts tokbor",
    "auth:beon": "tsx scrapers/auth/cli.ts beon",
    "auth:pro-tok": "tsx scrapers/auth/cli.ts pro-tok",
    "scrape:yandex": "tsx scrapers/maps/yandex.ts",
    "scrape:google": "tsx scrapers/maps/google.ts",
    "merge": "tsx scrapers/merge.ts",
    "gate:pull": "bash scripts/gate/pull-apks.sh",
    "gate:screen": "tsx scripts/gate/screen-apk.ts"
  },
  "private": true,
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "geolib": "^3.3.4",
    "mongoose": "^9.2.1",
    "node-cron": "^4.6.0",
    "node-sqlite3-wasm": "^0.8.60",
    "puppeteer": "^24.37.5",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.0",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
