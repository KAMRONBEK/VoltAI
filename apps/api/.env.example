# --- server ---
PORT=8080
NODE_ENV=production
TZ=Asia/Tashkent
# CORS: the website origins (the mobile app is not subject to CORS). Empty = allow all.
CORS_ORIGINS=https://voltai.uz,https://www.voltai.uz

# --- embedded database (SQLite via node-sqlite3-wasm; MongoDB is retired) ---
# Where the on-device DB file lives. Defaults to ./data/voltai.sqlite when unset.
SQLITE_PATH=

# --- ingestion (POST /ingest) ---
# Shared secret for the x-ingest-token header. /ingest is loopback-only in production
# (never expose it through the tunnel). Required, or every /ingest call 401s.
INGEST_TOKEN=

# --- scheduling ---
# The phone re-scrapes every operator API on this cron, refreshing live charger statuses and
# rebuilding the canonical `stations` table. Default: every 5 minutes.
SCRAPE_CRON=*/5 * * * *
# Set to "false" to turn scraping off entirely (e.g. a read-replica fed only by /ingest).
SCRAPE_ENABLED=true
# Fallback merge cron — IGNORED while SCRAPE_ENABLED=true (each scrape cycle merges inline).
# Only used when scraping is disabled.
MERGE_CRON=*/15 * * * *

# --- HTTP caching (edge + client) ---
# The API origin is a single phone, so both Cloudflare and consumer apps cache these reads.
# The full catalog changes slowly → longer TTL; the /statuses feed is near-real-time → short.
# Values are seconds. s-maxage = shared/CDN cache; maxage = browser/client.
STATIONS_CACHE_MAXAGE=60
STATIONS_CACHE_SMAXAGE=180
STATUSES_CACHE_MAXAGE=20
STATUSES_CACHE_SMAXAGE=30
# Data older than this (since last successful scrape) is reported stale in /api/health/detail
# and in the /api/stations/statuses payload. Default: 900s (3x the 5-min scrape interval).
STATIONS_STALE_AFTER_SEC=900

# --- route planning (/api/plan) ---
# Road routing for the trip corridor. SERVER-SIDE ONLY: the key authenticates every call, so
# shipping it in a mobile bundle means it can be extracted and abused, and a rotation would break
# every installed client at once with no fix short of an app release.
# Without it /api/plan still answers, but falls back to straight-line geometry and marks the
# response `geometry: "estimated"` / `geometryTrusted: false`.
MYTAXI_API_KEY=
MYTAXI_BASE_URL=https://proxy.mytaxi.uz/v1
MYTAXI_TIMEOUT_MS=2500
# Our own ceilings, set below whatever the provider enforces (their limits are undocumented).
# Routes are cached for 90 days, so steady-state usage is far under these.
MYTAXI_RATE_PER_MIN=20
MYTAXI_RATE_PER_DAY=400
# Plan responses are cached hard because the origin is one phone. `live=1` requests fold in
# charger status and get the shorter policy.
PLAN_CACHE_MAXAGE=120
PLAN_CACHE_SMAXAGE=600
PLAN_LIVE_CACHE_MAXAGE=30
PLAN_LIVE_CACHE_SMAXAGE=60
# Concurrent plan computations before shedding with 503 + Retry-After.
PLAN_MAX_INFLIGHT=2

# --- one-time onboarding only ---
# OTP for creating charger-app accounts during capture setup; not needed at steady state.
GRIZZLYSMS_API_KEY=

# REMOVED: MONGODB_URI — the API now uses an embedded SQLite file, not MongoDB/Atlas.
