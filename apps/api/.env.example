# VoltAI API environment. Deployment steps: RUNBOOK.md — why it looks like this: ../../ARCHITECTURE.md
#
# HOW THIS FILE IS READ: by the app itself (dotenv, src/env.ts) from the process CWD (apps/api).
# The runit service does NOT shell-source it any more, so values need no shell quoting — but keep
# it simple anyway (no `$VAR`/`~` expansion happens: use ABSOLUTE paths).
# BLANK VALUES COUNT AS UNSET (`KEY=` == not set). Optional keys below are commented out.

# --- server ---
PORT=8080
# Bind address. Loopback by default: cloudflared and the on-device app both talk to 127.0.0.1.
# Set 0.0.0.0 only if you deliberately want the phone's Wi-Fi to reach the API.
# HOST=127.0.0.1
NODE_ENV=production
TZ=Asia/Tashkent
# CORS: the website origins (the mobile app is not subject to CORS). Empty = allow all.
CORS_ORIGINS=https://voltai.uz,https://www.voltai.uz

# --- embedded database (SQLite via node-sqlite3-wasm) ---
# Where the on-device DB file lives. Unset → ./data/voltai.sqlite relative to apps/api.
# On the phone use the absolute path bootstrap.sh writes:
# SQLITE_PATH=/data/data/com.termux/files/home/voltai/data/voltai.sqlite

# --- on-device data files (NOT in git — copied to the phone by deploy.sh --data) ---
# Operator login-replay bearer tokens (Tokbor, Beon, Pro-Tok). chmod 600. Without this file the
# phone loses Tokbor and Beon entirely — ~766 of ~1,226 canonical stations. Unset → ./data/auth-tokens.json
# AUTH_TOKENS_PATH=/data/data/com.termux/files/home/voltai/data/auth-tokens.json
# Per-station Tokbor name/price cache. Without it, Tokbor pins have no name and no price.
# TOKBOR_DETAILS_PATH=/data/data/com.termux/files/home/voltai/data/tokbor-details.json

# --- daily consistent DB snapshot (VACUUM INTO, in-process; what backup.sh archives) ---
# SNAPSHOT_ENABLED=true
# SNAPSHOT_DIR=<dir of SQLITE_PATH>/snapshots
# SNAPSHOT_HOUR=2
# SNAPSHOT_MINUTE=30

# --- nightly backup (scripts/termux/backup.sh; the phone holds the ONLY copy of the files above) ---
# rclone remote:path to upload the ENCRYPTED archive to. Configure the remote once with
# `rclone config` (e.g. a Cloudflare R2 bucket). Blank = local + shared-storage copies only.
BACKUP_REMOTE=
# Local + remote archives older than this many days are pruned. Default 14.
BACKUP_RETENTION_DAYS=14

# --- ingestion (POST /ingest, loopback-only side door) ---
# Shared secret for the x-ingest-token header. Required, or every /ingest call 401s. The route is
# additionally refused for any request not from 127.0.0.1 or arriving via the Cloudflare tunnel.
INGEST_TOKEN=

# --- scheduling ---
# The phone re-scrapes every operator API, refreshing live charger statuses and rebuilding the
# canonical `stations` table. The gap is RANDOMIZED in [MIN, MAX] minutes and measured AFTER each
# run completes — so runs never overlap and the polling never settles into a rhythm an operator
# API can fingerprint. Falls back to 3-5 if either value is unset, non-numeric or MAX < MIN.
SCRAPE_MIN_MINUTES=3
SCRAPE_MAX_MINUTES=5
# Set to "false" to turn scraping off entirely (e.g. a read-replica fed only by /ingest).
SCRAPE_ENABLED=true
# Fallback merge cron — IGNORED while SCRAPE_ENABLED=true (each scrape cycle merges inline).
MERGE_CRON=*/15 * * * *

# --- data freshness policy (mergeService / housekeeping) ---
# A raw row older than this many days is ignored by the merge (operator removed the charger, or
# its source has been dead for a week). Default 7.
# STATION_TTL_DAYS=7
# Connector statuses from a raw row older than this many seconds are shown as `unknown` — a frozen
# "available" from a dead source is never presented as current. Default 3600 (~12+ missed scrapes).
# STATUS_MAX_AGE_SEC=3600
# Raw rows nobody has reported for this many days are deleted. Default 30.
# RAW_RETENTION_DAYS=30

# --- HTTP caching (edge + client) ---
# The API origin is a single phone, so both Cloudflare and consumer apps cache these reads.
# The full catalog changes slowly → longer TTL; the /statuses feed is near-real-time → short.
# Values are seconds. s-maxage = shared/CDN cache; maxage = browser/client.
STATIONS_CACHE_MAXAGE=60
STATIONS_CACHE_SMAXAGE=180
STATUSES_CACHE_MAXAGE=20
STATUSES_CACHE_SMAXAGE=30
# Scheduler older than this (since last completed scrape cycle) is reported stale in
# /api/health/detail and makes /api/health/ready answer 503. Per-source staleness uses the same
# threshold against each source's lastIngestAt. Default 900s.
STATIONS_STALE_AFTER_SEC=900

# --- route planning (/api/plan) ---
# Road routing for the trip corridor. SERVER-SIDE ONLY: the key authenticates every call, so
# shipping it in a mobile bundle means it can be extracted and abused, and a rotation would break
# every installed client at once with no fix short of an app release.
# Without it /api/plan still answers, but falls back to straight-line geometry and marks the
# response `geometry: "estimated"` / `geometryTrusted: false` (and the app labels it as such).
MYTAXI_API_KEY=
MYTAXI_BASE_URL=https://proxy.mytaxi.uz/v1
MYTAXI_TIMEOUT_MS=2500
# Our own ceilings, set below whatever the provider enforces (their limits are undocumented).
# Routes are cached for 90 days, so steady-state usage is far under these.
MYTAXI_RATE_PER_MIN=20
MYTAXI_RATE_PER_DAY=400
# Per-client-IP ceiling on /api/plan (429 above it). Default 60/min (carrier CGNAT shares IPs).
# PLAN_RATE_PER_MIN=60
# Plan responses are cached hard because the origin is one phone. `live=1` requests fold in
# charger status and get the shorter policy.
PLAN_CACHE_MAXAGE=120
PLAN_CACHE_SMAXAGE=600
PLAN_LIVE_CACHE_MAXAGE=30
PLAN_LIVE_CACHE_SMAXAGE=60
# Concurrent plan computations before shedding with 503 + Retry-After.
PLAN_MAX_INFLIGHT=2

# --- client control channel (GET /api/client-config, read by the app at launch, fail-open) ---
# Installed apps below this version get a blocking "update required" sheet.
# CLIENT_MIN_VERSION=1.0.0
# One-off notice shown to users (outage, migration…). Blank = none.
# CLIENT_MESSAGE=
# true → the app shows a maintenance banner.
# CLIENT_MAINTENANCE=false

# --- auto-update (scripts/termux/updater.sh, the voltai-updater service) ---
# Every green push to `main` publishes a GitHub Release `api-<sha>`; the phone polls it every 5 min
# and applies it (restart + smoke test, rollback on failure). Set false to freeze the phone.
# AUTO_UPDATE=true
# GITHUB_REPO=KAMRONBEK/VoltAI

# --- watchdog (scripts/termux/watchdog.sh) ---
# Public URL probed to decide whether the tunnel needs a restart.
# PUBLIC_HEALTH_URL=https://api.voltai.uz/api/health

# --- one-time onboarding only ---
# OTP for creating charger-app accounts during capture setup; not needed at steady state.
GRIZZLYSMS_API_KEY=
