# VoltAI API environment. Deployment steps: RUNBOOK.md — why it looks like this: ../../ARCHITECTURE.md
#
# ⚠️ THIS FILE IS SHELL-SOURCED, NOT PARSED. The runit service does `set -a; . ./.env` on every
# start (scripts/termux/install-services.sh:18), so any value containing spaces, `*`, `?` or `$`
# MUST be quoted. An unquoted cron like  */15 * * * *  glob-expands against apps/api and the shell
# then tries to EXECUTE the first filename it matches, on every single service start.
#
# --- server ---
PORT=8080
NODE_ENV=production
TZ=Asia/Tashkent
# CORS: the website origins (the mobile app is not subject to CORS). Empty = allow all.
CORS_ORIGINS=https://voltai.uz,https://www.voltai.uz

# --- embedded database (SQLite via node-sqlite3-wasm; MongoDB is retired) ---
# Where the on-device DB file lives. Defaults to ./data/voltai.sqlite when unset.
SQLITE_PATH=

# --- on-device data files (NOT in git — copy them to the phone by hand; see RUNBOOK.md §3) ---
# Operator login-replay bearer tokens (Tokbor, Beon, Pro-Tok). chmod 600. Without this file the
# phone loses Tokbor and Beon entirely — 766 of 1,226 canonical stations.
# Defaults to ./data/auth-tokens.json when unset.
AUTH_TOKENS_PATH=
# Per-station Tokbor name/price cache. Without it, Tokbor pins have no name and no price.
# Defaults to ./data/tokbor-details.json when unset.
TOKBOR_DETAILS_PATH=

# --- nightly backup (scripts/termux/backup.sh; the phone holds the ONLY copy of the 3 files above) ---
# rclone remote:path to upload the gzipped SQLite + token JSONs to. Configure the remote once with
# `rclone config` (e.g. a Cloudflare R2 bucket). Leave blank to disable backups (NOT recommended).
BACKUP_REMOTE=
# Local + remote archives older than this many days are pruned. Defaults to 14 when unset.
BACKUP_RETENTION_DAYS=14

# --- ingestion (POST /ingest) ---
# Shared secret for the x-ingest-token header. Required, or every /ingest call 401s — and this
# token is the ONLY application-layer protection: nothing in the code binds /ingest to loopback.
# Keeping it off the internet is an OPERATOR responsibility — the cloudflared ingress rule
# `path: ^/ingest -> http_status:404` (scripts/cloudflared/config.example.yml) is what enforces it.
INGEST_TOKEN=

# --- scheduling ---
# The phone re-scrapes every operator API, refreshing live charger statuses and rebuilding the
# canonical `stations` table. The gap is RANDOMIZED in [MIN, MAX] minutes and measured AFTER each
# run completes — so runs never overlap and the polling never settles into a rhythm an operator
# API can fingerprint. Falls back to 3-5 if either value is unset, non-numeric or MAX < MIN.
# (src/index.ts:97-126. There is no SCRAPE_CRON — the old name was read by nothing.)
SCRAPE_MIN_MINUTES=3
SCRAPE_MAX_MINUTES=5
# Set to "false" to turn scraping off entirely (e.g. a read-replica fed only by /ingest).
SCRAPE_ENABLED=true
# Fallback merge cron — IGNORED while SCRAPE_ENABLED=true (each scrape cycle merges inline).
# Only used when scraping is disabled. QUOTED: see the shell-sourcing warning at the top.
MERGE_CRON="*/15 * * * *"

# --- HTTP caching (edge + client) ---
# The API origin is a single phone, so both Cloudflare and consumer apps cache these reads.
# The full catalog changes slowly → longer TTL; the /statuses feed is near-real-time → short.
# Values are seconds. s-maxage = shared/CDN cache; maxage = browser/client.
STATIONS_CACHE_MAXAGE=60
STATIONS_CACHE_SMAXAGE=180
STATUSES_CACHE_MAXAGE=20
STATUSES_CACHE_SMAXAGE=30
# Data older than this (since last successful scrape) is reported stale in /api/health/detail
# and in the /api/stations/statuses payload. Default: 900s — roughly 3x the upper bound of the
# randomized 3-5 min scrape window. NOTE: this only catches a STOPPED scheduler; it stays fresh
# even if every source is failing, because lastScrapeAt is stamped unconditionally. See RUNBOOK §6.
STATIONS_STALE_AFTER_SEC=900

# --- route planning (/api/plan) ---
# Road routing for the trip corridor. SERVER-SIDE ONLY: the key authenticates every call, so
# shipping it in a mobile bundle means it can be extracted and abused, and a rotation would break
# every installed client at once with no fix short of an app release.
# Without it /api/plan still answers, but falls back to straight-line geometry and marks the
# response `geometry: "estimated"` / `geometryTrusted: false`.
MYTAXI_API_KEY=
MYTAXI_BASE_URL=https://proxy.mytaxi.uz/v1
MYTAXI_TIMEOUT_MS=2500
# Our own ceilings, set below whatever the provider enforces (their limits are undocumented).
# Routes are cached for 90 days, so steady-state usage is far under these.
MYTAXI_RATE_PER_MIN=20
MYTAXI_RATE_PER_DAY=400
# Plan responses are cached hard because the origin is one phone. `live=1` requests fold in
# charger status and get the shorter policy.
PLAN_CACHE_MAXAGE=120
PLAN_CACHE_SMAXAGE=600
PLAN_LIVE_CACHE_MAXAGE=30
PLAN_LIVE_CACHE_SMAXAGE=60
# Concurrent plan computations before shedding with 503 + Retry-After.
PLAN_MAX_INFLIGHT=2

# --- one-time onboarding only ---
# OTP for creating charger-app accounts during capture setup; not needed at steady state.
GRIZZLYSMS_API_KEY=

# REMOVED: MONGODB_URI — the API now uses an embedded SQLite file, not MongoDB/Atlas.
