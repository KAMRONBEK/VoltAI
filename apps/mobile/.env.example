# Yandex MapKit Mobile SDK key — used by app.config.ts to enable the map on native builds.
# Get one at https://developer.tech.yandex.ru (MapKit Mobile SDK). Activation takes ~15 min.
# Copy this file to `.env` and fill in the value; never commit `.env`.
YANDEX_MAPKIT_API_KEY=

# Runtime alternative (dev convenience): same key value, inlined into the JS bundle so it can
# be swapped in with a Metro reload instead of a native rebuild. Read in app/_layout.tsx.
EXPO_PUBLIC_YANDEX_MAPKIT_API_KEY=

# NOTE: there is deliberately no MyTaxi key here. Routing happens server-side, so the key lives
# in apps/api/.env as MYTAXI_API_KEY. An EXPO_PUBLIC_ key is extractable from any shipped bundle,
# and if it were abused or rotated every installed copy would break at once, with no fix short of
# an app release. Do not add it to eas.json either.

# Override the API base URL (default: https://api.voltai.uz). Useful for pointing at a
# locally-run API in dev, e.g. http://127.0.0.1:8080 through `adb reverse tcp:8080 tcp:8080`.
# Use 127.0.0.1 (not localhost) so adb reverse's IPv4 forward is used. Read in lib/apiBaseUrl.ts.
# Leave it unset (commented) to use production; an empty value is also treated as "use production".
# EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8080
